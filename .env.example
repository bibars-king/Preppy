# Supabase — find these in your project's API settings (https://supabase.com/dashboard)
# Public values: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Never expose to the browser or commit it.
# Used exclusively by scripts/seed.ts to load content past row-level security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for auth redirects). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
